# Copy this file to backend/.env and fill in your values.
# backend/.env is git-ignored: never commit real credentials.

# From https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Two-letter market code used for track availability
SPOTIFY_MARKET=GB

# Where to send people after logging in with Spotify
FRONTEND_URL=http://127.0.0.1:5173

# Set to true when served over HTTPS in production
COOKIE_SECURE=false
